{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Run App",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "jinja": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on (http://127.0.0.1:8000)",
        "action": "openUrl",
        "url": "http://127.0.0.1:8000/docs"
      }
    }
  ]
}